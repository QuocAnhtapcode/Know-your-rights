# Non-secret settings only. Default remains fail-closed.
# Reserved Firebase runtime variables are set by the platform, not this file.
# Pin a model that supports Responses Structured Outputs and web_search.
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
KYR_BACKEND_MODE=cloud-live
# Allowed cloud modes are cloud-live and the visibly labelled cloud-mock fallback,
# and only for project know-your-rights-cd8b5.
# Also requires runtime/demo enabled + syntheticOnly + explicit server-side quotas.
# OPENAI_API_KEY and DEMO_ACCESS_CODE belong in Secret Manager, never in .env.

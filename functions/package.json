{
  "name": "know-your-rights-functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.cjs",
  "engines": {
    "node": "22"
  },
  "files": [
    "lib/index.cjs",
    "lib/index.cjs.map",
    ".env.example"
  ],
  "scripts": {
    "build": "npm run typecheck && node ../scripts/build-functions.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "npm --prefix .. run lint",
    "test": "npm --prefix .. test -- --project node"
  },
  "dependencies": {
    "@google-cloud/firestore": "9.1.0",
    "firebase-admin": "14.4.0",
    "firebase-functions": "7.3.2",
    "openai": "7.15.0",
    "uuid": "11.1.1",
    "zod": "4.6.2"
  },
  "overrides": {
    "gaxios": {
      "uuid": "$uuid"
    }
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}

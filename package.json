{
  "name": "know-your-rights",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "install:all": "npm ci && npm --prefix functions ci",
    "build": "npm run build:frontend && npm run build:functions",
    "build:frontend": "tsc -p tsconfig.app.json && vite build",
    "build:functions": "npm --prefix functions run build",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && npm --prefix functions run typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "npm run build:functions && node scripts/run-emulators.mjs test",
    "test:rules": "npm run test:emulator -- --rules-only",
    "emulators": "npm run build:functions && node scripts/run-emulators.mjs start",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:secrets": "node scripts/secret-scan.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:bundle && npm run check:secrets"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "firebase-tools": "15.30.0",
    "globals": "17.12.0",
    "jsdom": "26.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
